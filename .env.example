# Default credentials (recommended)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=

# Optional per-chain RPC overrides. These take precedence over ALCHEMY_API_KEY.
ETH_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=

# Optional per-chain explorer overrides. Etherscan V2 uses ETHERSCAN_API_KEY by default.
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
BSCSCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# Tenderly (optional — enables decoded call traces)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
